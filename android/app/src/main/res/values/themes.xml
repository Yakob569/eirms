<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EIRSPay" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- System splash hands off to the in-app teal splash, so both share the brand background. -->
    <style name="Theme.EIRSPay.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.EIRSPay</item>
    </style>
</resources>
